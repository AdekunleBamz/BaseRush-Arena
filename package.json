{
  "name": "baserush-arena",
  "version": "2.0.0",
  "private": true,
  "description": "A feature-rich Web3 prediction game dApp on Base Network with achievements, analytics, and modern UX",
  "keywords": [
    "web3",
    "dapp",
    "prediction",
    "game",
    "base",
    "ethereum",
    "nextjs",
    "react"
  ],
  "author": "BaseRush Arena Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next out node_modules/.cache",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "export": "next export",
    "serve": "npx serve out",
    "test": "echo \"No tests specified yet\"",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@reown/appkit": "^1.5.0",
    "@reown/appkit-adapter-wagmi": "^1.5.0",
    "@tanstack/react-query": "^5.56.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  },
  "optionalDependencies": {
    "porto": "*"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead"
  ],
  "devDependencies": {
    "eslint": "^9.39.2"
  }
}
